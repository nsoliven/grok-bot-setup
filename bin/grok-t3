#!/usr/bin/env bash
# grok-t3: status, pause and webhook tests for grok-bot-setup's T3 alerts.
set -euo pipefail
repo="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
config="$HOME/.config/grok-bot-setup/config.env"
if [[ -f "$config" ]]; then set -a; . "$config"; set +a; fi
exec "${BUN:-$(command -v bun || echo "$HOME/.bun/bin/bun")}" run "$repo/src/cli.ts" "$@"
