# grok-bot-setup settings. scripts/install.sh copies this to ~/.config/grok-bot-setup/config.env.
# Nothing in this file is secret. Secrets are files in ~/.config/grok-bot-setup/secrets/ (0600):
#   grok-webhook-url             the routine's private webhook URL
#   grok-webhook-authorization   the routine's Authorization header value

# --- T3 Code -----------------------------------------------------------------
T3_STATE_DB=~/.t3/userdata/statev2.sqlite

# --- When to wake the assistant --------------------------------------------------
# A question (or an approval) has waited this long:
NOTIFY_ANSWER_AFTER_MIN=10
# A run finished or failed and you have not opened the thread since:
NOTIFY_FINISHED_AFTER_MIN=30
# One reminder this long after the first notice, then silence for that thread:
NOTIFY_REMINDER_AFTER_MIN=180
# Batches go out at most this often, and at most this many per rolling day:
NOTIFY_MIN_GAP_MIN=20
NOTIFY_DAILY_CAP=12
# Never send a first notice for something older than this (e.g. after downtime):
NOTIFY_MAX_FIRST_NOTICE_AGE_MIN=720
# Only threads that started waiting in the last N days count at all:
WATCH_WINDOW_DAYS=7
WATCH_POLL_SECONDS=30

# --- What the webhook carries ---------------------------------------------------
# Thread and project titles. Set 0 to send ids and status only.
PAYLOAD_INCLUDE_TITLES=1
# Optional prefix for a tap-to-open link; the thread id is appended.
PAYLOAD_LINK_BASE=
HOST_LABEL=

